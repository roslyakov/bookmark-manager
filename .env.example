# Copy this file to .env and fill in real values.
# Never commit .env — it contains secrets.

# ---------------------------------------------------------------------------
# General
# ---------------------------------------------------------------------------
APP_ENV=development
# Base URL of the web app (used in bot messages / login links).
APP_BASE_URL=http://localhost:3000
# Public domain this deployment is served on (used by Traefik routing rules
# in production; not used in local dev).
PUBLIC_DOMAIN=bookmarks.example.com

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Full connection string used by all services (db/bot/worker/web), asyncpg
# driver. Alembic (in db/) derives a sync DSN from this automatically.
#
# Local dev (bundled `postgres` service, see docker-compose.local.yml):
#   DATABASE_URL=postgresql+asyncpg://bookmarks:bookmarks@postgres:5432/bookmarks
# VPS (externally-managed Postgres on the shared `db_external` network,
# reachable by that Postgres container's name/alias):
#   DATABASE_URL=postgresql+asyncpg://bookmarks:CHANGE_ME@postgres-host:5432/bookmarks
DATABASE_URL=postgresql+asyncpg://bookmarks:bookmarks@postgres:5432/bookmarks

# Used by the bundled local-dev `postgres` service only (must match the
# credentials embedded in DATABASE_URL above for local dev).
POSTGRES_DB=bookmarks
POSTGRES_USER=bookmarks
POSTGRES_PASSWORD=bookmarks

# Optional: connection string for a Postgres *superuser* (or a role with
# CREATEROLE/CREATEDB), used ONLY by the `migrate` service to idempotently
# create the app role/database if they don't exist yet. Leave unset if the
# database and role are already provisioned externally (e.g. by ansible on
# the VPS) — this is the recommended production setup.
# POSTGRES_ADMIN_URL=postgresql+asyncpg://postgres:CHANGE_ME@postgres-host:5432/postgres

# ---------------------------------------------------------------------------
# Telegram bot
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=CHANGE_ME
# Public HTTPS URL Telegram will POST updates to (must include the webhook
# path below). On the VPS this is https://<PUBLIC_DOMAIN><TELEGRAM_WEBHOOK_PATH>,
# fronted by Traefik. Locally, point this at an ngrok/cloudflared tunnel.
TELEGRAM_WEBHOOK_URL=https://bookmarks.example.com/telegram/webhook
TELEGRAM_WEBHOOK_PATH=/telegram/webhook
# Secret Telegram echoes back in the X-Telegram-Bot-Api-Secret-Token header
# on every webhook request; used to reject forged requests (REQUIREMENTS.md
# §11). Generate with: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=CHANGE_ME
# Host port the bot's HTTP server is published on for local dev only
# (docker-compose.local.yml). Not used in production (Traefik routes
# directly to the container).
BOT_HTTP_PORT=8080

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
AUTH_TOKEN_TTL_MINUTES=15
# Secret used to sign the web app's session cookie (JWT). Generate with:
# openssl rand -hex 32
WEB_SESSION_SECRET=CHANGE_ME

# ---------------------------------------------------------------------------
# Metadata worker
# ---------------------------------------------------------------------------
METADATA_WORKER_ENABLED=true
METADATA_FETCH_MAX_PER_SECOND=1
METADATA_FETCH_DELAY_MS=1000
METADATA_FETCH_TIMEOUT_MS=5000
METADATA_FETCH_MAX_RETRIES=3
METADATA_FETCH_RETRY_DELAY_MS=30000
METADATA_FETCH_MAX_RESPONSE_SIZE_BYTES=2097152
METADATA_JOB_LOCK_TIMEOUT_MS=300000
METADATA_WORKER_BATCH_SIZE=1

# ---------------------------------------------------------------------------
# Production deployment wiring (VPS only — see docker-compose.prod.yml)
# ---------------------------------------------------------------------------
# Name of the Docker network the externally-managed Postgres container is
# attached to (created outside this project, e.g. by ansible).
EXTERNAL_DB_NETWORK=postgres_default
# Name of the Docker network Traefik is attached to.
TRAEFIK_NETWORK=traefik_default
TRAEFIK_ENTRYPOINT=websecure
# Traefik certificate resolver name configured for Let's Encrypt.
TRAEFIK_CERTRESOLVER=letsencrypt
